erDiagram
    ESTABELECIMENTO ||--o{ LOTE_ALIMENTO : oferece
    LOTE_ALIMENTO ||--o| DOACAO : "possui no maximo uma"
    INSTITUICAO ||--o{ DOACAO : recebe

    ESTABELECIMENTO {
        NUMBER ID PK
        VARCHAR2 NOME
        VARCHAR2 TIPO
        VARCHAR2 EMAIL UK
        VARCHAR2 TELEFONE
        VARCHAR2 ENDERECO
        VARCHAR2 BAIRRO
        VARCHAR2 CIDADE
    }

    INSTITUICAO {
        NUMBER ID PK
        VARCHAR2 NOME
        VARCHAR2 EMAIL UK
        VARCHAR2 TELEFONE
        VARCHAR2 ENDERECO
        VARCHAR2 BAIRRO
        VARCHAR2 CIDADE
    }

    LOTE_ALIMENTO {
        NUMBER ID PK
        NUMBER ESTABELECIMENTO_ID FK
        VARCHAR2 DESCRICAO
        VARCHAR2 CATEGORIA
        NUMBER QUANTIDADE_KG
        TIMESTAMP6 PRAZO_APROVEITAMENTO
        VARCHAR2 STATUS
    }

    DOACAO {
        NUMBER ID PK
        NUMBER LOTE_ID FK "UK"
        NUMBER INSTITUICAO_ID FK
        VARCHAR2 STATUS
        TIMESTAMP6 DATA_RESERVA
        TIMESTAMP6 DATA_COLETA
        TIMESTAMP6 DATA_ENTREGA
        NUMBER QUANTIDADE_ENTREGUE_KG
    }
