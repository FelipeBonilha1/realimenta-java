# Modelo sem credenciais. O Spring Boot NAO le este arquivo sozinho.
# Copie os valores para variaveis de ambiente do terminal, da IDE ou do Render.
# Confirme host, porta e servico/SID com o responsavel de Database Design e com o Oracle da FIAP.

DB_URL=jdbc:oracle:thin:@//HOST_PENDENTE:1521/SERVICO_PENDENTE
DB_USERNAME=USUARIO_PENDENTE
DB_PASSWORD=SENHA_PENDENTE
PORT=8080

# Schema exclusivo de teste. Nao use o usuario do grupo.
# DB_IT_SCHEMA_EXCLUSIVO=true libera .\mvnw.cmd -Poracle-it test
DB_IT_URL=jdbc:oracle:thin:@//HOST_PENDENTE:1521/SERVICO_PENDENTE
DB_IT_USERNAME=USUARIO_EXCLUSIVO_DE_TESTE
DB_IT_PASSWORD=SENHA_PENDENTE
DB_IT_SCHEMA_EXCLUSIVO=false
